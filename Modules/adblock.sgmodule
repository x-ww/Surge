#!name=AdBlock
#!desc=去广告（引用上游列表），需开启 MITM 才能完整生效
#!category=x-ww
#!author=x-ww
#!homepage=https://github.com/x-ww/Surge
#!requirement=CORE_VERSION>=20

[Rule]
# 域名主体（Sukka 规则集，DOMAIN-SET 磁盘索引，内存开销低）
DOMAIN-SET,https://ruleset.skk.moe/List/domainset/reject.conf,REJECT
DOMAIN-SET,https://ruleset.skk.moe/List/domainset/reject_extra.conf,REJECT
DOMAIN-SET,https://ruleset.skk.moe/List/domainset/reject_phishing.conf,REJECT
# 通配符 + 关键词（含 doubleclick 等 KEYWORD 规则）
RULE-SET,https://ruleset.skk.moe/List/non_ip/reject.conf,REJECT
# 静默丢包
RULE-SET,https://ruleset.skk.moe/List/non_ip/reject-drop.conf,REJECT-DROP
RULE-SET,https://ruleset.skk.moe/List/non_ip/reject-no-drop.conf,REJECT-NO-DROP
# 广告落地页 IP（放最后，会触发 DNS 解析）
RULE-SET,https://ruleset.skk.moe/List/ip/reject.conf,REJECT-DROP
