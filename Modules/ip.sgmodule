#!name=IP Info
#!desc=Display the current device's public IP, country
#!category=x-ww
#!version=1.0
#!icon=globe.asia.australia
#!icon-color=#6699FF

[Script]
IP面板 = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/x-ww/Surge/refs/heads/main/Modules/ip.js,argument="icon=globe.asia.australia&icon-color=#6699FF"

[Panel]
IP面板 = script-name=IP面板,update-interval=600