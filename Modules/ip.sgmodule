#!name=IP information
#!desc=IP information
#!category=x-ww
#!arguments=
#!arguments-desc=1 为开启, 0 为关

[MITM]
hostname = %APPEND% 

[Script]
IP面板 = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/x-ww/Surge/refs/heads/main/Modules/ip-panel.js

# Event
{{{EVENT_SCRIPT_NAME}}} = type=event

# Panel
网络信息面板 = t

[Panel]
IP面板 = script-name=IP面板,update-interval=600