[Script]
落地 IP 面板 = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/x-ww/Surge/main/Modules/ip-panel.js

[Panel]
落地 IP 面板 = script-name=落地 IP 面板,update-interval=600
