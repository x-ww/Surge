#!name=IP Info
#!desc=Display IP, location, ISP and ASN info
#!category=x-ww
#!icon=globe.asia.australia
#!icon-color=#6699FF

[Script]
IP面板 = type=generic,timeout=10,script-path=https://cdn.jsdelivr.net/gh/x-ww/Surge@main/Modules/ip.js,argument="icon=globe.asia.australia&icon-color=%236699FF"

[Panel]
IP面板 = script-name=IP面板,update-interval=3600
